{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloud Deck",
  "version": "0.1.0",
  "identifier": "app.clouddeck.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:18774",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cloud Deck",
        "width": 1220,
        "height": 820,
        "minWidth": 920,
        "minHeight": 660,
        "center": true,
        "backgroundColor": "#F1F2F7",
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "管理云端账号、应用和工作空间",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "resources": {
      "../../cloud_agent.py": "cloud/cloud_agent.py",
      "../../cloud_lifecycle.py": "cloud/cloud_lifecycle.py",
      "../../cloud_heartbeat.py": "cloud/cloud_heartbeat.py",
      "../applications/": "cloud/applications/"
    }
  }
}
